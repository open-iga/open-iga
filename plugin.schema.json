{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Name of the plugin"
    },
    "version": {
      "type": "string",
      "description": "Version of the plugin"
    },
    "environmentVariables": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Environment variables required by the plugin. Provide an empty aray if no environment variables are required."
    },
    "entitlements": {
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "description": {
            "type": "string",
            "description": "List of actions supported by the entitlement. This will be shown to the user when choosing the entitlement"
          },
          "actions": {
            "type": "object",
            "propertyNames": {
              "type": "string",
              "enum": [
                "provision",
                "deprovision",
                "list",
                "update"
              ]
            },
            "additionalProperties": {
              "type": "object",
              "properties": {
                "export": {
                  "type": "string",
                  "description": "Name of the exported function name"
                },
                "description": {
                  "type": "string",
                  "description": "Description of the exported function name"
                },
                "endpoint": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "method": {
                        "type": "string",
                        "enum": [
                          "GET",
                          "POST",
                          "PATCH",
                          "PUT"
                        ],
                        "description": "HTTP Method"
                      },
                      "url": {
                        "type": "string",
                        "description": "Upstream URL that needs to be whitelisted"
                      }
                    },
                    "required": [
                      "method",
                      "url"
                    ],
                    "additionalProperties": false
                  }
                }
              },
              "required": [
                "export",
                "description",
                "endpoint"
              ],
              "additionalProperties": false
            },
            "required": [
              "provision",
              "deprovision",
              "list",
              "update"
            ]
          }
        },
        "required": [
          "description",
          "actions"
        ],
        "additionalProperties": false
      },
      "description": "Entitlement supported by the plugin. This is a key-value object where key is the supported entitlement with actions as value."
    }
  },
  "required": [
    "name",
    "version",
    "environmentVariables",
    "entitlements"
  ],
  "additionalProperties": false
}
